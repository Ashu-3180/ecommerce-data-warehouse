# ShopSphere configuration
# Copy this file to .env and adjust values as needed.
# Do not commit a real .env file.

# Dataset size (development defaults are small on purpose)
NUM_CUSTOMERS=500
NUM_PRODUCTS=200
NUM_STORES=30
NUM_ORDERS=1000
AVG_ITEMS_PER_ORDER=3
MAX_ITEMS_PER_ORDER=12

# Reproducibility
RANDOM_SEED=42

# Share of records that receive intentional data-quality issues (2–3%)
DIRTY_DATA_RATE=0.025

# Historical window (ISO dates)
HISTORICAL_START_DATE=2023-01-01
HISTORICAL_END_DATE=2025-12-31

# Optional path overrides (leave unset to use project folders)
# RAW_DATA_DIR=
# REJECTED_DATA_DIR=
# LOG_DIR=
LOG_LEVEL=INFO

# ETL data-quality gate (percent). Run fails if any source table is below this.
QUALITY_THRESHOLD=95
PIPELINE_NAME=shopsphere_batch_etl

# PostgreSQL (local developer instance)
# Copy this file to .env and replace CHANGE_ME with your real password.
# Do not commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopsphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Final portfolio-scale example (do not use until you are ready for a long run)
# NUM_CUSTOMERS=50000
# NUM_PRODUCTS=10000
# NUM_STORES=250
# NUM_ORDERS=500000
# AVG_ITEMS_PER_ORDER=3
# ---------------------------------------------------------------------------
