	partition monthly_sales = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "shopsphere", [HierarchicalNavigation=true]),
				    analytics = Source{[Schema="analytics"]}[Data],
				    monthly_sales1 = analytics{[Name="monthly_sales"]}[Data]
