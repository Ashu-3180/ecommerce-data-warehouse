table _Measures
	lineageTag: ee12117d-d97b-4c05-84b4-5055f0156e78

	measure 'Total Revenue' =

			SUM(monthly_sales[sales])
		formatString: "₹#,0.00"
		lineageTag: ec3c447b-e694-4e40-9d8a-1b1f016f3dd4


	measure 'Total Profit' =

			SUM(monthly_sales[profit])
		formatString: "₹#,0.00"
		lineageTag: 25d40e70-fed7-4da2-87f1-232de9446b5d


	measure 'Total Orders' =

			SUM(monthly_sales[orders])
		formatString: "#,0"
		lineageTag: 40ad9f88-0308-4545-a5bf-46cf5f2d11f4

	measure 'Units Sold' =

			SUM(monthly_sales[units])
		formatString: "#,0"
		lineageTag: 97db8b33-c1fe-4bc0-8042-482fda6f70ec

	measure 'Profit Margin %' =

			DIVIDE(
			    [Total Profit],
			    [Total Revenue],
			    0
			)
		formatString: "0.00%"
		lineageTag: 3e281ca0-ce73-4767-bb1b-c50e4eaa08af


	measure 'Average Order Value' =

			DIVIDE(
			    [Total Revenue],
			    [Total Orders],
			    0
			)
		formatString: "₹#,0.00"
		lineageTag: 68b1ee68-b794-4ce5-ba24-ab2987d69df9


	measure 'Purchasing Customers' =

			DISTINCTCOUNT(customer_performance[customer_id])
		formatString: "#,0"
		lineageTag: 0d61721b-ea0a-4e68-8a66-717d7b7783b9

	measure 'Customer Revenue' =

			SUM(customer_performance[sales])
		formatString: "₹#,0.00"
		lineageTag: 82a3db5c-947c-4e30-b01a-13299e07dfbe


	measure 'Customer Profit' =

			SUM(customer_performance[profit])
		formatString: "₹#,0.00"
		lineageTag: 7534f058-ec73-4521-bd06-ea6dd92ec297


	measure 'Customer Orders' =

			SUM(customer_performance[orders])
		formatString: "#,0"
		lineageTag: 6893c9fb-d61c-4d64-b937-93744aadc4b6

	measure 'Revenue per Purchasing Customer' =

			DIVIDE(
			    [Customer Revenue],
			    [Purchasing Customers],
			    0
			)
		formatString: "₹#,0.00"
		lineageTag: 3006bb83-ee79-4aec-ba3e-dc0ecfd4b085


	measure 'Store Revenue' =

			SUM(store_performance[sales])
		formatString: "₹#,0.00"
		lineageTag: ddfb75d2-40e8-4e89-bd68-132a592d249f


	measure 'Store Profit' =

			SUM(store_performance[profit])
		formatString: "₹#,0.00"
		lineageTag: 8fcbf35f-c82b-4cd8-a13e-7bba3fe13dab


	measure 'Store Orders' =

			SUM(store_performance[orders])
		formatString: "#,0"
		lineageTag: 4cd4c0c3-7ec5-401b-8e6d-3e54c943eeda

	measure 'Total Deliveries' =

			SUM(delivery_performance[deliveries])
		formatString: "#,0"
		lineageTag: a1f754ea-ac18-4c10-b1e6-ceb3f3e1b076

	measure 'Average Delivery Time (Minutes)' =

			DIVIDE(
			    SUMX(
			        delivery_performance,
			        delivery_performance[avg_time_minutes]
			            * delivery_performance[deliveries]
			    ),
			    [Total Deliveries],
			    0
			)
		formatString: "#,0.00"
		lineageTag: 88e26e8d-6532-4591-9570-7f6c65f27919


	measure 'Average Delivery Distance (KM)' =

			DIVIDE(
			    SUMX(
			        delivery_performance,
			        delivery_performance[avg_distance_km]
			            * delivery_performance[deliveries]
			    ),
			    [Total Deliveries],
			    0
			)
		formatString: "#,0.00"
		lineageTag: 138a24a6-1697-49db-b8e6-9ffc141e33c6


	measure 'Total Pipeline Runs' =

			COUNTROWS(pipeline_runs)
		formatString: "#,0"
		lineageTag: 58f1db40-de83-4fd5-975a-7b5d499c2519

	measure 'Successful Runs' =

			VAR Result =
			    CALCULATE(
			        [Total Pipeline Runs],
			        pipeline_runs[status] = "SUCCESS"
			    )
			RETURN
			    IF(ISBLANK(Result), 0, Result)
		formatString: "#,0"
		lineageTag: 622732ce-99b8-4c85-a631-a298e7eacd57

	measure 'Failed Runs' =

			VAR Result =
			    CALCULATE(
			        [Total Pipeline Runs],
			        pipeline_runs[status] = "FAILED"
			    )
			RETURN
			    IF(ISBLANK(Result), 0, Result)
		formatString: "#,0"
		lineageTag: e6d86bfb-ffc5-4a93-904f-5d7b94edb266

	measure 'Records Extracted' =

			SUM(pipeline_runs[records_extracted])
		formatString: "#,0"
		lineageTag: f7999117-d7fb-4ece-8995-3e54b5202970

	measure 'Records Validated' =

			SUM(pipeline_runs[records_validated])
		formatString: "#,0"
		lineageTag: fdcdfc90-9f80-4358-9140-ca3860e2b475

	measure 'Records Rejected' =

			SUM(pipeline_runs[records_rejected])
		formatString: "#,0"
		lineageTag: a7204002-d4ba-45f7-b88d-f194d3194678

	measure 'Records Loaded' =

			SUM(pipeline_runs[records_loaded])
		formatString: "#,0"
		lineageTag: 098f1e1f-8adc-4902-9667-5f2bb5154db9

	measure 'Average Pipeline Duration (Seconds)' =

			AVERAGEX(
			    FILTER(
			        pipeline_runs,
			        NOT ISBLANK(pipeline_runs[completed_at])
			            && NOT ISBLANK(pipeline_runs[started_at])
			    ),
			    DATEDIFF(
			        pipeline_runs[started_at],
			        pipeline_runs[completed_at],
			        SECOND
			    )
			)
		formatString: "#,0.00"
		lineageTag: 1840546e-3d62-4337-93cd-158e09c3e9cf


	measure 'Latest Quality Score' =

			VAR LatestRun =
			    TOPN(
			        1,
			        FILTER(
			            ALL(pipeline_runs),
			            NOT ISBLANK(pipeline_runs[completed_at])
			        ),
			        pipeline_runs[started_at], DESC,
			        pipeline_runs[run_id], DESC
			    )
			RETURN
			    MAXX(
			        LatestRun,
			        pipeline_runs[quality_score]
			    )
		formatString: "0.00"
		lineageTag: af7d4ff7-6ea0-4c1e-a013-b7c7aa6e75d8


	measure 'Records Checked' =

			SUM(data_quality_results[records_checked])
		formatString: "#,0"
		lineageTag: 00d87300-c7b4-4b35-a093-f57bedf1d2f7

	measure 'Records Failed' =

			SUM(data_quality_results[records_failed])
		formatString: "#,0"
		lineageTag: 21cf3277-ceb6-46d6-9b8c-770bbaebbb74

	measure 'Data Quality Failure Rate %' =

			DIVIDE(
			    [Records Failed],
			    [Records Checked],
			    0
			)
		formatString: "0.00%"
		lineageTag: 0a16292e-d8af-4874-84ea-43e499d057f5

	measure 'Category Revenue Share %' =

			DIVIDE(
			    SUM(category_performance[sales]),
			    CALCULATE(
			        SUM(category_performance[sales]),
			        ALL(category_performance)
			    ),
			    0
			)
		formatString: "0.00%"
		lineageTag: 11a6c0d4-3e72-4b18-9f55-2c8d7a1b6e30

	measure 'Category Profit Margin %' =

			DIVIDE(
			    SUM(category_performance[profit]),
			    SUM(category_performance[sales]),
			    0
			)
		formatString: "0.00%"
		lineageTag: 22b7d1e5-4f83-4c29-8a66-3d9e8b2c7f41

	measure 'Channel Revenue Share %' =

			DIVIDE(
			    SUM(channel_performance[sales]),
			    CALCULATE(
			        SUM(channel_performance[sales]),
			        ALL(channel_performance)
			    ),
			    0
			)
		formatString: "0.00%"
		lineageTag: 33c8e2f6-5a94-4d3a-9b77-4e0f9c3d8052

	measure 'Channel Profit Margin %' =

			DIVIDE(
			    SUM(channel_performance[profit]),
			    SUM(channel_performance[sales]),
			    0
			)
		formatString: "0.00%"
		lineageTag: 44d9f307-6ba5-4e4b-8c88-5f1a0d4e9163

	measure 'Product Revenue Share %' =

			DIVIDE(
			    SUM(product_performance[sales]),
			    CALCULATE(
			        SUM(product_performance[sales]),
			        ALL(product_performance)
			    ),
			    0
			)
		formatString: "0.00%"
		lineageTag: 55e00418-7cb6-4f5c-9d99-602b1e5fa274

	measure 'Product Profit Margin %' =

			DIVIDE(
			    SUM(product_performance[profit]),
			    SUM(product_performance[sales]),
			    0
			)
		formatString: "0.00%"
		lineageTag: 66011529-8dc7-406d-8eaa-713c2f60b385

	measure 'Customer Segment Revenue Share %' =

			DIVIDE(
			    [Customer Revenue],
			    CALCULATE(
			        [Customer Revenue],
			        ALL(customer_performance[customer_segment])
			    ),
			    0
			)
		formatString: "0.00%"
		lineageTag: 7712263a-9ed8-417e-9fbb-824d3071c496

	measure 'Delivery Status Share %' =

			DIVIDE(
			    [Total Deliveries],
			    CALCULATE(
			        [Total Deliveries],
			        ALL(delivery_performance[delivery_status])
			    ),
			    0
			)
		formatString: "0.00%"
		lineageTag: 8823374b-0fe9-428f-80cc-935e4182d5a7

	column Placeholder
		isHidden
		formatString: 0
		lineageTag: 073d1864-8c3a-4c3c-88a8-6aa859816925
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source =

				ROW(
				    "Placeholder",
				    BLANK()
				)

	annotation PBI_Id = 4a8a6f91aab04872941c3f14dce819ed

